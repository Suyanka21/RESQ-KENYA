{
  "rules": {
    ".read": false,
    ".write": false,

    "activeRequests": {
      "$requestId": {
        ".read": "auth != null && (data.child('customerId').val() === auth.uid || data.child('providerId').val() === auth.uid)",
        ".write": false
      }
    },

    "providerLocations": {
      ".read": false,
      ".write": false
    }
  }
}
