rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user owns this document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Check if user is the assigned provider
    function isAssignedProvider(providerId) {
      return request.auth.uid == providerId;
    }
    
    // =============================================
    // USERS COLLECTION
    // =============================================
    match /users/{userId} {
      // Users can only read/write their own profile
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);

      // Never allow direct deletion
      allow delete: if false;

      // ---- Vehicles subcollection (Phase 5) ----
      // Owner can READ. All writes (create/update/delete) MUST go through
      // the addVehicle / updateVehicle / deleteVehicle callables so the
      // single-primary invariant + plate validation are enforced server-
      // side. Direct client writes would let a malicious client bypass
      // those callable checks (CodeRabbit PR #3, comment 2).
      match /vehicles/{vehicleId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }

      // ---- Emergency contacts subcollection (Phase 5) ----
      // Owner can READ. All writes (create/update/delete) MUST go
      // through the addEmergencyContact / updateEmergencyContact /
      // deleteEmergencyContact callables so MAX_CONTACTS=5 and phone
      // normalisation are enforced server-side (CodeRabbit PR #3,
      // comment 2).
      match /emergency_contacts/{contactId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // =============================================
    // WALLETS COLLECTION (Phase 5)
    // =============================================
    // Users can read their own wallet doc and ledger.
    // Writes go through the wallet callables (admin SDK bypasses rules).
    match /wallets/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create, update, delete: if false;

      match /ledger/{entryId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }
    }
    
    // =============================================
    // PROVIDERS COLLECTION
    // =============================================
    match /providers/{providerId} {
      // Anyone authenticated can read providers (for matching)
      allow read: if isAuthenticated();
      
      // Providers can only update their own profile
      allow create: if isAuthenticated() && isOwner(providerId);
      allow update: if isAuthenticated() && isOwner(providerId);
      
      // Never allow direct deletion
      allow delete: if false;
    }
    
    // =============================================
    // REQUESTS COLLECTION
    // =============================================
    match /requests/{requestId} {
      // Customers can read their own requests
      // Providers can read requests assigned to them
      // Providers can read pending requests (for matching)
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.status == 'pending'
      );
      
      // Only Cloud Functions should create requests
      // But allow if user is creating their own
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Customers can update their own pending requests (cancel)
      // Providers can update assigned requests (status updates)
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && resource.data.status == 'pending') ||
        (resource.data.providerId == request.auth.uid)
      );
      
      // Never allow direct deletion
      allow delete: if false;
    }
    
    // =============================================
    // PAYMENT REQUESTS COLLECTION
    // =============================================
    match /payment_requests/{requestId} {
      // Customers can read their own payment requests
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Only Cloud Functions should create/update payments
      // Allow create if user is the authenticated user
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Updates only from Cloud Functions (admin SDK bypasses rules)
      allow update: if false;
      
      // Never allow deletion
      allow delete: if false;
    }
    
    // =============================================
    // CORPORATE ACCOUNTS (B2B) - Future
    // =============================================
    match /corporate_accounts/{accountId} {
      // Only corporate admins can access
      allow read, write: if isAuthenticated() && 
        get(/databases/$(database)/documents/corporate_accounts/$(accountId)).data.admins.hasAny([request.auth.uid]);
    }
    
    // =============================================
    // LEGACY TOP-LEVEL VEHICLES COLLECTION (deprecated in Phase 5)
    // =============================================
    // Phase 5 migrated to users/{uid}/vehicles. This rule remains for
    // legacy READS while migration scripts move data over. All writes
    // are blocked from clients; new writes must go through the
    // addVehicle callable. Allowing client writes here would re-create
    // the split-brain vehicle data the Phase 5 migration was meant to
    // eliminate (CodeRabbit PR #3, comment 3).
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }
  }
}
