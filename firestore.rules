rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAssignedProvider(providerId) {
      return request.auth.uid == providerId;
    }

    // True iff the only fields changing in this update are in the
    // allow-list. Used to scope provider/customer self-updates to a
    // safe subset.
    //
    // `request.resource.data.diff(resource.data).affectedKeys()` is
    // the canonical way to get the set of changed top-level keys.
    // https://firebase.google.com/docs/firestore/security/rules-conditions#data_validation
    function affectedKeysAreSubsetOf(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(allowedKeys);
    }

    // =============================================
    // USERS COLLECTION
    // =============================================
    //
    // Phase 4 (audit-v2 §N-HIGH-2) hardening: the previous rule was
    // `allow update: if isAuthenticated() && isOwner(userId)` with
    // **no field allow-list**, which let a logged-in user overwrite
    // any field on their own user doc — including `role`,
    // `wallet.balance`, `referralCredits`, `vehicles[]`, etc. The
    // legacy `firestore.service.ts:addVehicle` shim (audit §N-HIGH-1)
    // exploited that, writing to the deprecated `vehicles[]` array.
    //
    // The fix mirrors the `providers/{providerId}` allow-list
    // pattern at firestore.rules:101-112: clients can only write
    // profile-presentation fields. Privileged data (role, wallet,
    // verification, balances) is server-authoritative.
    //
    // Skills: Security-and-Hardening (least privilege, default-deny
    // on unspecified fields), API-and-Interface-Design (rule
    // documents what the contract is, not what the client happens
    // to send today).
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);

      // Self-create on first sign-in. Restrict create-time fields
      // to the safe initial subset and pin privileged values
      // (membership = 'basic', loyaltyPoints = 0) so a malicious
      // client cannot pre-seed `membership: 'gold'` or
      // `loyaltyPoints: 999999`.
      allow create: if isAuthenticated()
                    && isOwner(userId)
                    && request.resource.data.keys().hasOnly([
                         'id',
                         'displayName',
                         'photoUrl',
                         'phone',
                         'phoneNumber',
                         'email',
                         'fcmToken',
                         'pushTokens',
                         'preferredLanguage',
                         'role',
                         'membership',
                         'loyaltyPoints',
                         'createdAt',
                         'updatedAt'
                       ])
                    && (
                      !('role' in request.resource.data) ||
                      request.resource.data.role in ['customer', 'provider']
                    )
                    && (
                      !('membership' in request.resource.data) ||
                      request.resource.data.membership == 'basic'
                    )
                    && (
                      !('loyaltyPoints' in request.resource.data) ||
                      request.resource.data.loyaltyPoints == 0
                    );

      // Self-update is restricted to profile-presentation fields.
      // Vehicles, emergency contacts, saved locations, role,
      // wallet, balances, referralCredits all flow through their
      // dedicated callables and bypass these rules via admin SDK.
      allow update: if isAuthenticated()
                    && isOwner(userId)
                    && affectedKeysAreSubsetOf([
                         'displayName',
                         'photoUrl',
                         'phone',
                         'phoneNumber',
                         'email',
                         'fcmToken',
                         'pushTokens',
                         'preferredLanguage',
                         'updatedAt'
                       ]);

      allow delete: if false;

      // ---- Vehicles subcollection (Phase 5) ----
      // Owner can READ. All writes (create/update/delete) MUST go
      // through the addVehicle / updateVehicle / deleteVehicle
      // callables so the single-primary invariant + plate validation
      // are enforced server-side.
      match /vehicles/{vehicleId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }

      // ---- Emergency contacts subcollection (Phase 5) ----
      // Owner can READ. All writes MUST go through the
      // addEmergencyContact / updateEmergencyContact /
      // deleteEmergencyContact callables so MAX_CONTACTS=5 and phone
      // normalisation are enforced server-side.
      match /emergency_contacts/{contactId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // =============================================
    // WALLETS COLLECTION (Phase 5)
    // =============================================
    match /wallets/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create, update, delete: if false;

      match /ledger/{entryId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // =============================================
    // PROVIDERS COLLECTION
    // =============================================
    //
    // Phase 3 (B-HIGH-7) hardening: clients can NOT write
    // `verificationStatus`, `serviceTypes`, `earnings`, `escrow`, or
    // `geohash`. Those fields are server-authoritative (admin SDK
    // bypasses these rules). The setProviderAvailability /
    // updateProviderLocation Cloud Functions enforce the
    // "verified before online" gate and own the geohash.
    match /providers/{providerId} {
      allow read: if isAuthenticated();

      // Provider self-create is fine — the verification workflow
      // sets verificationStatus to 'pending' on the first write
      // through the verifyProvider callable, but we still need to
      // permit the initial doc.
      allow create: if isAuthenticated()
                    && isOwner(providerId)
                    && request.resource.data.verificationStatus in ['pending', 'unverified'];

      // Self-update is restricted to a presentation/profile subset.
      // Anything else (verification, earnings, dispatch, escrow,
      // currentRequestId, geohash, availability) MUST go through
      // the corresponding callable.
      allow update: if isAuthenticated()
                    && isOwner(providerId)
                    && affectedKeysAreSubsetOf([
                         'displayName',
                         'displayPhotoUrl',
                         'phone',
                         'email',
                         'fcmToken',
                         'pushTokens',
                         'preferredLanguage',
                         'updatedAt'
                       ]);

      allow delete: if false;
    }

    // =============================================
    // REQUESTS COLLECTION
    // =============================================
    //
    // Phase 3 (B-CRIT-3 / B-CRIT-4): no client-side direct creates
    // or updates. createServiceRequest, acceptServiceRequest,
    // updateRequestStatus, and cancelServiceRequest are all
    // callables — they bypass these rules via admin SDK. Direct
    // client writes would let a caller set status='accepted',
    // self-assign providerId, or mutate pricing/payment/total.
    match /requests/{requestId} {
      // Read access: customer owner, assigned provider, or any
      // provider when the request is still pending (for the
      // "nearby pending requests" list).
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.status == 'pending'
      );

      // No client-side writes.
      allow create, update, delete: if false;
    }

    // =============================================
    // PAYMENT REQUESTS COLLECTION
    // =============================================
    //
    // Phase 3 (B-CRIT-2): clients used to be allowed to create
    // payment_requests rows with arbitrary status, including
    // 'completed'. That let a malicious caller pre-create a
    // "fake-paid" idempotency key that the legitimate STK push
    // would then short-circuit through. Now: all writes server-
    // only via admin SDK; clients can only READ their own row.
    match /payment_requests/{paymentRequestId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;

      allow create, update, delete: if false;
    }

    // =============================================
    // PRICE QUOTES (Phase 2 contract)
    // =============================================
    match /price_quotes/{quoteId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // =============================================
    // CORPORATE ACCOUNTS (B2B) - Future
    // =============================================
    match /corporate_accounts/{accountId} {
      allow read, write: if isAuthenticated()
        && get(/databases/$(database)/documents/corporate_accounts/$(accountId)).data.admins.hasAny([request.auth.uid]);
    }

    // =============================================
    // LEGACY TOP-LEVEL VEHICLES COLLECTION (deprecated in Phase 5)
    // =============================================
    // Phase 5 migrated to users/{uid}/vehicles. This rule remains for
    // legacy READS while migration scripts move data over. All writes
    // are blocked; new writes must go through the addVehicle callable.
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // =============================================
    // SOS EVENTS — Phase 4 (audit-v2 §N-MED-7)
    // =============================================
    // Written exclusively by the `triggerEmergencySOS` callable
    // (server-authoritative). Owner can read their own history;
    // nobody can write directly. A future contact-fanout worker
    // (server-side) updates `status` after dispatching.
    match /sos_events/{eventId} {
      allow read: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // server-only via callable
    }

    // =============================================
    // DEFAULT DENY
    // =============================================
    // Anything not explicitly matched above is denied. Belt-and-
    // braces protection against future collections being added
    // without a corresponding rule block.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
